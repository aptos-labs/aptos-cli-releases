{
  lib,
  stdenvNoCC,
  fetchzip,
  autoPatchelfHook,
}:

let
  version = "{{VERSION}}";
  sources = {
    x86_64-linux = fetchzip {
      url = "https://github.com/aptos-labs/aptos-cli-releases/releases/download/aptos-cli-v${version}/aptos-cli-${version}-x86_64-unknown-linux-gnu.zip";
      hash = "sha256-{{SHA256_X86_64_LINUX}}";
      stripRoot = false;
    };
    aarch64-linux = fetchzip {
      url = "https://github.com/aptos-labs/aptos-cli-releases/releases/download/aptos-cli-v${version}/aptos-cli-${version}-aarch64-unknown-linux-gnu.zip";
      hash = "sha256-{{SHA256_AARCH64_LINUX}}";
      stripRoot = false;
    };
    x86_64-darwin = fetchzip {
      url = "https://github.com/aptos-labs/aptos-cli-releases/releases/download/aptos-cli-v${version}/aptos-cli-${version}-x86_64-apple-darwin.zip";
      hash = "sha256-{{SHA256_X86_64_DARWIN}}";
      stripRoot = false;
    };
    aarch64-darwin = fetchzip {
      url = "https://github.com/aptos-labs/aptos-cli-releases/releases/download/aptos-cli-v${version}/aptos-cli-${version}-aarch64-apple-darwin.zip";
      hash = "sha256-{{SHA256_AARCH64_DARWIN}}";
      stripRoot = false;
    };
  };
in
stdenvNoCC.mkDerivation {
  pname = "aptos-cli-bin";
  inherit version;

  src = sources.${stdenvNoCC.hostPlatform.system} or (throw "Unsupported system: ${stdenvNoCC.hostPlatform.system}");

  nativeBuildInputs = lib.optionals stdenvNoCC.hostPlatform.isLinux [ autoPatchelfHook ];

  installPhase = ''
    runHook preInstall
    install -Dm755 aptos $out/bin/aptos
    runHook postInstall
  '';

  meta = {
    description = "CLI for the Aptos blockchain";
    homepage = "https://github.com/aptos-labs/aptos-cli-releases";
    license = lib.licenses.asl20;
    maintainers = [ ];
    platforms = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];
    mainProgram = "aptos";
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };
}
